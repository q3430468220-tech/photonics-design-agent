# Copy to .env and fill in. The CLI loads .env from the repo root (or current dir) if present.

# ---- LLM provider -------------------------------------------------------
# anthropic | openai | scripted
PRISM_LLM_PROVIDER=anthropic
PRISM_MODEL=claude-sonnet-4-5

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenAI-compatible (DeepSeek / Qwen / relay services all use this)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# PRISM_MODEL=deepseek-chat

# ---- Simulation backend --------------------------------------------------
# mock | lumerical
PRISM_BACKEND=mock

# Lumerical install root (folder that contains api/python/lumapi.py). ASCII path only.
LUMERICAL_ROOT=D:/Program Files/ANSYS Inc/v251
